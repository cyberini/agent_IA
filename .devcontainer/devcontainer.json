{
  // Environnement identique pour tout le monde :
  // - en ligne avec GitHub Codespaces (bouton "Open in Codespaces")
  // - en local avec Docker + VS Code (extension "Dev Containers")
  "name": "Atelier Agents IA (Google ADK)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Installe les dépendances (versions figées) à la création de l'environnement
  "postCreateCommand": "git config core.hooksPath .githooks; git config core.fileMode false; chmod +x .githooks/pre-commit lancer.sh; pip install --upgrade pip && pip install -r requirements.txt; [ -f .env ] || cp .env.example .env",

  // Message d'accueil à chaque ouverture
  "postAttachCommand": "echo '\n👋 Bienvenue ! 1) Mets ta clé dans le fichier .env  2) Lance : bash lancer.sh\n'",

  // Le port 8000 = l'interface "adk web"
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Interface ADK Web",
      "onAutoForward": "openBrowser"
    }
  },

  // Machine la plus petite = consomme le moins le quota gratuit Codespaces
  "hostRequirements": {
    "cpus": 2
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "mikestead.dotenv"
      ],
      "settings": {
        "files.exclude": {
          "**/__pycache__": true
        }
      }
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
